{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "llm-live-npc-spc-research",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "SPC_RESEARCH_OPERATOR_TOKEN"
    ]
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "HEARTH_COGNITION_MODEL": "gpt-5.6-luna",
    "HEARTH_COGNITION_REASONING": "low",
    "HEARTH_COGNITION_MAX_OUTPUT_TOKENS": "4096",
    "SPC_NEXT_LIFE_INTENT_MODEL": "gpt-5.6-luna",
    "SPC_NEXT_LIFE_INTENT_REASONING": "low",
    "SPC_NEXT_LIFE_INTENT_MAX_OUTPUT_TOKENS": "4096",
    "SPC_RESEARCH_LUNA_ONLY": "true"
  },
  "ratelimits": [
    {
      "name": "AI_PROBE_LIMITER",
      "namespace_id": "982731",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "HEARTH_COGNITION_LIMITER",
      "namespace_id": "982732",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
