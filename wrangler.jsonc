{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "llm-live-npc",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "preview_urls": true,
  "secrets": { "required": ["OPENAI_API_KEY"] },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "HEARTH_COGNITION_MODEL": "gpt-5.6-luna",
    "HEARTH_COGNITION_REASONING": "low",
    "HEARTH_COGNITION_MAX_OUTPUT_TOKENS": "4096"
  },
  "ratelimits": [
    {
      "name": "AI_PROBE_LIMITER",
      "namespace_id": "731947",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "HEARTH_COGNITION_LIMITER",
      "namespace_id": "731948",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
