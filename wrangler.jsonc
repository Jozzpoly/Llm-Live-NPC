{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "llm-live-npc",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
